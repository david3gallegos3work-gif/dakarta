{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dakarta",
  "version": "0.4.6",
  "identifier": "io.github.dakarta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dakarta",
        "width": 1100,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "license": "AGPL-3.0-or-later",
    "copyright": "Dakarta. Motor PDF: MuPDF © Artifex Software, Inc. (AGPL-3.0)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
